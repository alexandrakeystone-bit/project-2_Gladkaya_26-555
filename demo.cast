[12.183921, "o", "\r\n\u001b[?2004l\r"]
[12.579556, "o", "\r\n***База данных***\r\n\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи.\r\n"]
[12.57975, "o", "<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя> set <col> = <val> where <col> = <val> - обновить.\r\n<command> delete from <имя> where <col> = <val> - удалить.\r\n<command> info <имя_таблицы> - информация о таблице.\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n>>>Введите команду: "]
[18.556762, "o", "create_table users name:str age:int"]
[19.444705, "o", "\r\n"]
[19.453057, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int\r\n>>>Введите команду: "]
[25.639193, "o", "insert into users values (\"Sergei\", 28)"]
[26.785579, "o", "\r\n"]
[26.792065, "o", "Функция insert выполнилась за 0.000 секунд.\r\n"]
[26.796576, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n>>>Введите команду: "]
[33.150396, "o", "select from users"]
[35.003037, "o", "\r\n"]
[35.00934, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[35.355269, "o", "+----+--------+-----+\r\n| ID |  name  | age |\r\n+----+--------+-----+\r\n| 1  | Sergei |  28 |\r\n+----+--------+-----+\r\n>>>Введите команду: "]
[42.107057, "o", "delete from users where name = \"Sergei\""]
[43.147932, "o", "\r\n"]
[43.154238, "o", "Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[44.819451, "o", "y"]
[45.727335, "o", "\r\n"]
[45.734659, "o", "Удалено записей: 1.\r\n>>>Введите команду: "]
[53.178078, "o", "drop_table users"]
[54.175277, "o", "\r\n"]
[54.179845, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[56.482351, "o", "y"]
[57.244495, "o", "\r\n"]
[57.249715, "o", "Таблица \"users\" успешно удалена.\r\n>>>Введите команду: "]
[58.838347, "o", "e"]
[59.523652, "o", "x"]
[59.718787, "o", "i"]
[60.190511, "o", "t"]
[60.982057, "o", "\r\n"]
[60.987961, "o", "Выход из программы.\r\n"]
